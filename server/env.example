# grokbot server configuration — copy to ../.env and fill in.
# The server reads it via `node --env-file=../.env` (see package.json scripts).

# --- Model provider ---------------------------------------------------------
# xAI upstream:
#   XAI_API_KEY=xai-...
#   XAI_MODEL=grok-4.7
# Any OpenAI Chat Completions provider works too (auto-detected when the base
# URL is not api.x.ai; force with XAI_CHAT_MODE=1). Example: Z.AI GLM:
XAI_API_KEY=
XAI_MODEL=glm-5.3
XAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# XAI_CHAT_MODE=1

# --- Computers: self-hosted E2B (replaces Orgo cloud) ------------------------
# Point these at your E2B deployment. E2B_DOMAIN is NOT used on self-hosted
# port-based addressing; the SDK wants the API and client-proxy URLs.
E2B_API_KEY=
E2B_API_URL=http://192.168.100.252:3000
E2B_SANDBOX_URL=http://192.168.100.252:3002
E2B_TEMPLATE=base
# Kept for Orgo-cloud deployments; ignored by the E2B adapter:
# ORGO_API_KEY=...
# ORGO_WORKSPACE_ID=...
ORGO_RESOLUTION=1280x800x24

# --- Integrations (optional) -------------------------------------------------
# Without a Composio key the toolkit catalog is simply empty.
COMPOSIO_API_KEY=

# --- Server ------------------------------------------------------------------
PORT=8787
# Public URL of the server (OAuth callbacks); for LAN demos use the VM IP.
SERVER_URL=http://192.168.100.246:8787
APP_URL=http://192.168.100.246:8787
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Dev login without OAuth (demo mode): DEV_LOGIN=1
DEV_LOGIN=1
